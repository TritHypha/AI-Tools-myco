# build output
dist/

# test-created scratch directories
/test/.link-monitor-verification/
/test/.links-*/
/test/myco-ceiling-*/
/test/myco-pathfilter-*/
/test/node-compile-cache/

# dependencies
node_modules/

# the myco index itself (never commit an index)
.myco/

# logs / os cruft
*.log
.DS_Store
Thumbs.db

# myco is self-contained: never let a broad 'vendor/' rule (here, in a global
# excludesFile, or in a project that vendors myco) drop the TriRegex engine.
!src/vendor/
!src/vendor/triregex/**
