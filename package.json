{
  "name": "myco",
  "version": "0.1.3",
  "description": "grep, but it grows a graph — a graph-indexed search tool for file contents and filenames. Smart-case, token-precise, and instant on repeat searches.",
  "type": "module",
  "bin": {
    "myco": "dist/cli.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "DESIGN.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TritHypha/myco.git"
  },
  "homepage": "https://github.com/TritHypha/myco#readme",
  "bugs": {
    "url": "https://github.com/TritHypha/myco/issues",
    "email": "hello@trithypha.dev"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/TritHypha"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node --experimental-strip-types src/cli.ts",
    "test": "node scripts/run-tests.mjs",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "grep",
    "search",
    "graph",
    "index",
    "code-search",
    "ripgrep",
    "find",
    "smart-case",
    "cli"
  ],
  "author": "TritHypha <hello@trithypha.dev>",
  "license": "Apache-2.0",
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.8.0"
  }
}
