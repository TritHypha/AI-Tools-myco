# myco run-all every 3 hours (Linux / macOS / WSL with cron running). Edit paths.
# m h dom mon dow  command
0 */3 * * *  cd $HOME/src/myco && $HOME/.nvm/versions/node/v24.18.0/bin/node --experimental-strip-types --no-warnings src/cli.ts run-all --config $HOME/myco-repos.json >> $HOME/myco-review/cron.log 2>&1
